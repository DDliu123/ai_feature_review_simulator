datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  isVerified       Boolean      @default(false)
  verifyCode       String?
  verifyCodeExpiry DateTime?    @map("verify_code_expiry")
  createdAt        DateTime     @default(now()) @map("created_at")
  documents        Document[]
  refreshTokens    RefreshToken[]
}

model Document {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  filename    String
  fileUrl     String         @map("file_url")
  parsedText  String?        @map("parsed_text")
  status      String         @default("PENDING") // PENDING/REVIEWING/PASSED/FAILED
  createdAt   DateTime       @default(now()) @map("created_at")
  deletedAt   DateTime?      @map("deleted_at")
  user        User           @relation(fields: [userId], references: [id])
  reviewSessions ReviewSession[]
}

model ReviewSession {
  id            String       @id @default(uuid())
  documentId    String       @map("document_id")
  rolesSelected String       @map("roles_selected")
  overallStatus String       @default("IN_PROGRESS") // IN_PROGRESS/ALL_PASSED/PARTIAL
  reportUrl     String?      @map("report_url")
  createdAt     DateTime     @default(now()) @map("created_at")
  document      Document     @relation(fields: [documentId], references: [id])
  roleThreads   RoleThread[]
}

model RoleThread {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  roleKey   String   @map("role_key")
  messages  String
  status    String   @default("CHALLENGING") // CHALLENGING/PARTIAL/APPROVED
  roundCount Int     @default(1) @map("round_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  session   ReviewSession @relation(fields: [sessionId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id])
}
