{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.moonshot.ai/v1/(.*)"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "index.html": {
      "excludeFiles": "{assets/**,node_modules/**}"
    }
  }
}